{
  "name": "pi-colgrep",
  "version": "3.1.0",
  "description": "Pi extension: ColGrep semantic code search as agent tools, plus a delegated code-localization agent (colgrep --agent, local 2B model). Local fork of @gotgenes/pi-colgrep with colgrep-first guidance.",
  "type": "module",
  "imports": {
    "#src/*": "./src/*",
    "#test/*": "./test/*"
  },
  "files": [
    "src",
    "skills",
    "THIRD_PARTY_LICENSES",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "pi-coding-agent",
    "colgrep",
    "semantic-search",
    "code-search",
    "code-localization"
  ],
  "author": {
    "name": "Clement Garrot",
    "url": "https://github.com/cgarrot"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cgarrot/pi-colgrep.git"
  },
  "homepage": "https://github.com/cgarrot/pi-colgrep#readme",
  "bugs": {
    "url": "https://github.com/cgarrot/pi-colgrep/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "pi": {
    "extensions": [
      "./src/extension.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.1.0",
    "@earendil-works/pi-tui": "1.1.0",
    "@types/node": "^24.19.2",
    "typebox": "^1.3.37",
    "typescript": "^6.0.3",
    "vitest": "^5.0.4"
  }
}
